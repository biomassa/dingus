        "boxes": [
            {
                "box": {
                    "id": "gcode",
                    "maxclass": "codebox",
                    "code": "// dingus.toMidiIn: catches every note of a gate signal at the sample it happens, for dingus.toMidi.\n// Max reads signals only once per vector (snapshot~), so a short gate (a 1..10 ms trigger) or the 3 ms gap\n// between two notes can be over before it is read: the velocity reads 0, or a note start is missed.\n// Here each rise and fall is counted, and the velocity and pitch are held from the rise, so a reader that\n// looks every few ms sees every note: a new rise count = a new note; rises > falls = the gate is up.\n// in1 gate (level = velocity)  in2 pitch\n// out1 rises (count)  out2 falls (count)  out3 velocity at the last rise (the peak of its first ms)\n// out4 pitch at the last rise\nHistory up(0);\nHistory rises(0);\nHistory falls(0);\nHistory vel(0);\nHistory pit(0);\nHistory pk(0);\n\ng = in1;\nif (g > 0 && up == 0) {\n\trises = rises + 1;\n\tvel = g;\n\tpit = in2;\n\tpk = floor(samplerate * 0.001);\n\tup = 1;\n} else if (g <= 0 && up > 0) {\n\tfalls = falls + 1;\n\tup = 0;\n}\n// a gate that ramps up: its peak over the first ms is the velocity\nif (pk > 0) {\n\tpk = pk - 1;\n\tvel = max(vel, g);\n}\nout1 = rises;\nout2 = falls;\nout3 = vel;\nout4 = pit;\n",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "numinlets": 2,
                    "numoutlets": 4,
                    "outlettype": [
                        "",
                        "",
                        "",
                        ""
                    ],
                    "patching_rect": [
                        20.0,
                        50.0,
                        620.0,
                        560.0
                    ]
                }
            },
