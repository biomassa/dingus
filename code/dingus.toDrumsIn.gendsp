                        ""
                    ],
                    "patching_rect": [
                        20.0,
                        14.0,
                        40.0,
                        22.0
                    ]
                }
            },
            {
                "box": {
                    "id": "gout1",
                    "maxclass": "newobj",
                    "text": "out 1",
                    "numinlets": 1,
